{
    "name": "playable-cn/salesforce-rest-sdk",
    "description": "An SDK for the Salesforce Rest API",
    "type": "library",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "jms/serializer": "^3.0",
        "ramsey/uuid": "^3.8|^4.0",
        "doctrine/collections": "^1.5|^2.0",
        "symfony/cache": "^5.4|^6.0|^7.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "psr/http-message": "^1.1|^2.0",
        "symfony/expression-language": "^5.4|^6.0|^7.0",
        "jms/metadata": "^1.0|^2.0",
        "doctrine/annotations": "^1.13|^2.0"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Alex Boyce",
            "email": "alex.boyce@advisorsexcel.com"
        },
        {
            "name": "playable-cn",
            "email": "developer@playable.cn"
        }
    ],
    "autoload": {
        "psr-4": {
            "AE\\SalesforceRestSdk\\": ["src/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AE\\SalesforceRestSdk\\Tests\\": ["Tests/"]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0"
    }
}
